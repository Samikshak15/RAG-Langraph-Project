### 3. [NEW] Service Class: [`backend/app/services/candidate_service.py`](file:///e:/interview-intelligence-rag/backend/app/services/candidate_service.py)

#### Logic Workflow & Core Methods:

```python
import json
from pathlib import Path
from typing import Optional

from app.config import DATA_DIR
from app.ingestion.metadata_extractor import extract_s3_metadata, extract_session_start_time
from app.services.s3_service import S3Service


class CandidateService:
    def __init__(self, s3_service: Optional[S3Service] = None, registry_path: Optional[Path] = None):
        self.s3_service = s3_service or S3Service()
        self.registry_path = registry_path or (DATA_DIR / "candidates.json")
        self._load_registry()

    def _load_registry(self) -> None:
        """Load candidate name <-> user_id registry from JSON."""
        if self.registry_path.exists():
            with open(self.registry_path, "r", encoding="utf-8") as f:
                self.candidates = json.load(f)
        else:
            self.candidates = []

    def resolve_user_id(self, query_or_name: str) -> Optional[str]:
        """
        Find user_id given a candidate name or user_id string.
        - If query_or_name is already a numeric ID (e.g. "2071"), return it directly.
        - Otherwise perform case-insensitive name lookup (e.g. "Samiksha" -> "2071").
        """
        clean_query = query_or_name.strip()
        if clean_query.isdigit():
            return clean_query

        for candidate in self.candidates:
            if candidate["name"].lower() == clean_query.lower():
                return candidate["user_id"]
        return None

    def get_candidate_sessions(self, user_id: str, limit: int = 3) -> list[dict]:
        """
        1. List all transcript objects in S3 under simulation_training/{user_id}/
        2. Extract metadata and session_start_time for each object
        3. Sort sessions chronologically (newest first)
        4. Return top `limit` (e.g. latest 3) session metadata dictionaries
        """
        prefix = f"simulation_training/{user_id}/"
        objects = self.s3_service.list_objects(prefix=prefix)

        transcripts = [o for o in objects if o["Key"].endswith("_transcript.txt")]

        session_list = []
        for obj in transcripts:
            meta = extract_s3_metadata(obj["Key"])
            
            # Fetch raw text snippet to parse session timestamp if needed
            raw_bytes = self.s3_service.get_object(obj["Key"])
            raw_text = raw_bytes.decode("utf-8", errors="ignore")
            start_time = extract_session_start_time(raw_text)

            meta["session_start_time"] = start_time or obj.get("LastModified")
            meta["raw_text"] = raw_text
            meta["size"] = obj.get("Size", 0)

            session_list.append(meta)

        # Sort chronologically (newest first)
        session_list.sort(
            key=lambda s: s["session_start_time"] or datetime.min, 
            reverse=True
        )

        return session_list[:limit]
```

